# build products and secrets (regenerate with rpcbench/build.sh)
rpcbench/bin/
rpcbench/certs/
*.key
*.pem

# Python
__pycache__/
*.pyc
.venv/

# packet captures and TLS key logs
*.pcap
*.pcapng
sslkeys.log

